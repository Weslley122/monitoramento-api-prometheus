# Copie para .env e ajuste (cp .env.example .env). Sem .env, valem estes mesmos padrões.

# Versão da API (vira o rótulo "version" em todas as métricas).
APP_VERSION=v1.4.0
# false reproduz a versão antiga, com a consulta lenta em /pedidos.
PEDIDOS_CONSULTA_OTIMIZADA=true
# Req/s que cada réplica aguenta antes de ficar lenta e começar a falhar.
APP_CAPACIDADE_RPS=30

# Tráfego base do gerador de carga (req/s somando as 3 réplicas). O pico é o dobro.
RPS_BASE=60

# Senha do usuário admin do Grafana (http://localhost:3000).
GRAFANA_ADMIN_PASSWORD=admin
